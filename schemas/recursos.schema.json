{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo complementar de recursos",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "type",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "enum": [
        "curso",
        "portal",
        "ferramenta"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "checked_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
